# Copy the variables you need into backend/.env (gitignored, loaded via spring.config.import).
# Other required variables (DB, OAuth2, SECRET_KEY) are listed in src/main/resources/application*.yaml.

# file-service (shared upload service, see file-service/README.md)
FILE_SERVICE_URL=http://localhost:4000
# The blog's key: same value as API_KEY_BLOG in file-service/.env
FILE_SERVICE_API_KEY=

# mail-service (shared email service, see mail-service/docs/huong-dan-su-dung.md)
# Includes the /api prefix. mail-service and file-service both default to port 4000: run one of them with another PORT.
MAIL_SERVICE_URL=http://localhost:4000/api
# An API key created in mail-service's "API key" tab (scope mail:send); shown only once when created.
MAIL_SERVICE_API_KEY=
